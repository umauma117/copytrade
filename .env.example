# 复制本文件为 .env 后填写真实值（不要把 .env 发给任何人）

RPC_WS_URL=wss://...
RPC_HTTP_URL=https://...

LEADER_ADDRESSES=0x领袖钱包地址1,0x领袖钱包地址2

EXECUTE_COPY=false
COPY_SELL_ACTIONS=true

# 跟单钱包私钥（0x 开头，仅本机保存）
FOLLOWER_PRIVATE_KEY=

COPY_AMOUNT_RATIO=0.005
TAKE_PROFIT_PCT=30
TAKE_PROFIT_CHECK_INTERVAL=10

# 可选：未平仓仓位快照路径（默认 .positions_state.json）
# POSITIONS_STATE_FILE=.positions_state.json
